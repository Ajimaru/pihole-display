[Unit]
Description=Pi-hole OLED Display (BeagleBone Black)
After=network.target pihole-FTL.service unbound.service
Wants=pihole-FTL.service unbound.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pihole-display
ExecStart=/opt/pihole-display/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
