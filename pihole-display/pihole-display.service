[Unit]
Description=Pi-hole OLED Display (BeagleBone Black)
After=network.target pihole-FTL.service unbound.service
Wants=pihole-FTL.service unbound.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pihole-display
ExecStart=/opt/pihole-display/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Creates /var/lib/pihole-display with sane ownership for state.json
# and the web password file.
StateDirectory=pihole-display

# The service needs root for GPIO, I2C, systemctl and /etc/pihole/cli_pw,
# and it now listens on a network port - so fence in what it does not need.
# ProtectSystem=strict is deliberately absent: `pihole restartdns` and
# `systemctl` would need so many exceptions that it stops being useful.
#
# NoNewPrivileges is NOT set: `pihole -up` drops to the pihole user and
# uses sudo to get back to root, which that flag blocks. With it on, the
# update aborts after stopping FTL and leaves the network without DNS.
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
# RestrictSUIDSGID is NOT set either: it blocks the setuid sudo binary
# that `pihole -up` relies on.
# AF_NETLINK is required by psutil for network interface data.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
